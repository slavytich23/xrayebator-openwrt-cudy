#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

. /lib/functions.sh

XRAY=/usr/bin/xray
CONFIG=/etc/xrayebator-safe/client.json
GUARD=/usr/libexec/xrayebator-safe/route-guard
SUPERVISOR=/usr/libexec/xrayebator-safe/xray-supervisor
CHECK_TIMEOUT=20
CLIENT_NETWORK=lan
CLIENT_DEVICE=br-lan
CLIENT_SUBNET=192.168.10.0/24
HEALTH_BRIDGE=br-lan
HEALTH_ADDRESS=192.168.10.252/24
HEALTH_GATEWAY=192.168.10.1
HEALTH_DNS_SERVER=192.168.10.1
export XRAY_LOCATION_ASSET=/usr/share/xray

EXTRA_COMMANDS="check health"
EXTRA_HELP="\n\tcheck\tValidate the Xray configuration without starting it\n\thealth\tShow fail-closed policy and tunnel-route state"

load_settings() {
	configured_client_network=lan
	configured_client_device=br-lan
	configured_client_subnet=192.168.10.0/24
	configured_health_bridge=br-lan
	configured_health_address=192.168.10.252/24
	configured_health_gateway=192.168.10.1
	configured_health_dns_server=192.168.10.1

	config_load xrayebator_safe 2>/dev/null || true
	config_get configured_client_network main client_network "$configured_client_network"
	config_get configured_client_device main client_device "$configured_client_device"
	config_get configured_client_subnet main client_subnet "$configured_client_subnet"
	config_get configured_health_bridge main health_bridge "$configured_health_bridge"
	config_get configured_health_address main health_address "$configured_health_address"
	config_get configured_health_gateway main health_gateway "$configured_health_gateway"
	config_get configured_health_dns_server main health_dns_server "$configured_health_dns_server"

	CLIENT_NETWORK="${XRAYEBATOR_CLIENT_NETWORK:-$configured_client_network}"
	CLIENT_DEVICE="${XRAYEBATOR_CLIENT_DEVICE:-$configured_client_device}"
	CLIENT_SUBNET="${XRAYEBATOR_CLIENT_SUBNET:-$configured_client_subnet}"
	HEALTH_BRIDGE="${XRAYEBATOR_HEALTH_BRIDGE:-$configured_health_bridge}"
	HEALTH_ADDRESS="${XRAYEBATOR_HEALTH_ADDRESS:-$configured_health_address}"
	HEALTH_GATEWAY="${XRAYEBATOR_HEALTH_GATEWAY:-$configured_health_gateway}"
	HEALTH_DNS_SERVER="${XRAYEBATOR_HEALTH_DNS_SERVER:-$configured_health_dns_server}"
}

check() {
	[ -x "$XRAY" ] || {
		echo 'XRAY_BINARY_MISSING=true' >&2
		return 1
	}
	[ -s "$CONFIG" ] || {
		echo 'XRAY_CONFIG_MISSING=true' >&2
		return 1
	}
	"$XRAY" run -test -c "$CONFIG" >/dev/null 2>&1 &
	check_pid=$!
	(
		sleep "$CHECK_TIMEOUT"
		kill -TERM "$check_pid" >/dev/null 2>&1 || true
		sleep 2
		kill -KILL "$check_pid" >/dev/null 2>&1 || true
	) &
	watchdog_pid=$!
	wait "$check_pid"
	check_rc=$?
	kill "$watchdog_pid" >/dev/null 2>&1 || true
	wait "$watchdog_pid" >/dev/null 2>&1 || true
	[ "$check_rc" -eq 0 ] || {
		echo 'XRAY_CONFIG_VALID=false' >&2
		return 1
	}
	echo 'XRAY_CONFIG_VALID=true'
}

health() {
	"$GUARD" status
}

start_service() {
	check >/dev/null || return 1
	load_settings

	procd_open_instance guard
	procd_set_param command "$GUARD" run
	procd_set_param env \
		"XRAYEBATOR_LAN_NETWORK=$CLIENT_NETWORK" \
		"XRAYEBATOR_LAN_DEVICE=$CLIENT_DEVICE" \
		"XRAYEBATOR_LAN_SUBNET=$CLIENT_SUBNET"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance

	procd_open_instance xray
	procd_set_param command "$SUPERVISOR"
	procd_set_param env \
		"XRAY_LOCATION_ASSET=/usr/share/xray" \
		"XRAYEBATOR_GOMEMLIMIT=${XRAYEBATOR_GOMEMLIMIT:-80MiB}" \
		"XRAYEBATOR_GOGC=${XRAYEBATOR_GOGC:-50}" \
		"XRAYEBATOR_MAX_RSS_KB=${XRAYEBATOR_MAX_RSS_KB:-105000}" \
		"XRAYEBATOR_MIN_AVAILABLE_KB=${XRAYEBATOR_MIN_AVAILABLE_KB:-30000}" \
		"XRAYEBATOR_MEMORY_CHECK_INTERVAL=${XRAYEBATOR_MEMORY_CHECK_INTERVAL:-5}" \
		"XRAYEBATOR_PRESSURE_CONFIRMATIONS=${XRAYEBATOR_PRESSURE_CONFIRMATIONS:-3}" \
		"XRAYEBATOR_HEALTH_CHECK_INTERVAL=${XRAYEBATOR_HEALTH_CHECK_INTERVAL:-30}" \
		"XRAYEBATOR_HEALTH_FAILURE_CONFIRMATIONS=${XRAYEBATOR_HEALTH_FAILURE_CONFIRMATIONS:-3}" \
		"XRAYEBATOR_HEALTH_TIMEOUT=${XRAYEBATOR_HEALTH_TIMEOUT:-8}" \
		"XRAYEBATOR_HEALTH_RESTART_COOLDOWN=${XRAYEBATOR_HEALTH_RESTART_COOLDOWN:-600}" \
		"XRAYEBATOR_HEALTH_BRIDGE=$HEALTH_BRIDGE" \
		"XRAYEBATOR_HEALTH_ADDRESS=$HEALTH_ADDRESS" \
		"XRAYEBATOR_HEALTH_GATEWAY=$HEALTH_GATEWAY" \
		"XRAYEBATOR_HEALTH_DNS_SERVER=$HEALTH_DNS_SERVER"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

stop_service() {
	"$GUARD" cleanup
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger network firewall xrayebator_safe
}
